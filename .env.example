# Template for the API server's environment. Copy to `.env` and fill in real
# credentials — `.env` is git-ignored, this file is NOT. Never put a real
# password here.
#
#   cp .env.example .env

# --- Database (server/db.ts) ---------------------------------------------
# Either set DATABASE_URL, or set the discrete DB_* vars below.
# DATABASE_URL takes precedence when both are present.
# DATABASE_URL=mysql://user:password@localhost:3306/activityiq

DB_HOST=localhost
DB_PORT=3306
DB_NAME=activityiq
DB_USER=activityiq
DB_PASSWORD=

# Max pooled connections (optional, defaults to 10).
DB_POOL_SIZE=10

# --- App -----------------------------------------------------------------
# Signing secret for auth tokens. Generate a real one for any deployed env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# API port (optional, defaults to 4000).
PORT=4000
